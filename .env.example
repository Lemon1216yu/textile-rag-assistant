# Copy to .env; restart server after changes. Never commit real keys.
# With no LLM configuration the app returns original evidence excerpts.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-flash
LLM_API_KEY=
# Optional REAL semantic embeddings; all three values required.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Optional Redis for session facts. SQLite fallback is labelled in UI.
REDIS_URL=
