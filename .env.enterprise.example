# Development defaults. Production configuration is validated strictly.
APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8766
COOKIE_SECURE=false
ORGANIZATION=织知工作空间
# DATABASE_URL=mysql+pymysql://zhizhi:password@mysql:3306/zhizhi?charset=utf8mb4
REDIS_URL=
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=zhizhi_chunks_v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-flash
LLM_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=
# Copy your region/workspace endpoint from Bailian. Do not guess workspace IDs.
RERANK_URL=
RERANK_MODEL=gte-rerank-v2
RERANK_FORMAT=dashscope
RERANK_API_KEY=
# Optional Fernet key for encrypted workspace model settings. Keep this stable.
# Without it, development creates a restricted encryption.key under UPLOAD_DIR.
# MODEL_CONFIG_ENCRYPTION_KEY=
